# --- AI model (Claude) ---
# API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL: the default model. Options include claude-opus-5-5 (best),
# claude-sonnet-5-5 (about half the cost) and claude-haiku-4-5 (cheapest).
CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MODELS: optional comma-separated list. With more than one, the web chat shows a
# model picker, e.g. CLAUDE_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-4-5
CLAUDE_MODELS=
# CLAUDE_EFFORT: low, medium or high. Higher is more thorough but costs more. Opus and Sonnet only.
# CLAUDE_EFFORT=medium


# --- ConnectWise Manage (PSA) REST API ---
# Create an API Member in ConnectWise (System > Members > API Members) with a
# READ-ONLY security role, then generate API keys for it.
# CW_SITE: api-na.myconnectwise.net (US/Canada), api-eu... (Europe), api-au... (Australia),
# or your own server's hostname if self-hosted.
CW_SITE=api-na.myconnectwise.net
# CW_COMPANY_ID: the company ID you type on the ConnectWise login screen.
CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
# CW_CLIENT_ID: from https://developer.connectwise.com/ClientID
CW_CLIENT_ID=
# Only change the codebase if your instance differs:
# CW_CODEBASE=v4_6_release
# Ticket numbers in answers open the ticket in ConnectWise. The link is worked out from CW_SITE;
# set CW_TICKET_URL to use a different one ({id} is the ticket number), or CW_TICKET_URL=off for no links.
# CW_TICKET_URL=https://na.myconnectwise.net/v4_6_release/ConnectWise.aspx?locale=en_US&routeTo=ServiceFV&companyName=yourcompany&recid={id}
# Which company custom field holds each client's POS software (shown as "Software:" on the company).
# CW_SOFTWARE_FIELD=Software
# Go-lives: project tickets with these names (comma-separated) in the Scheduled status. The person
# scheduled on the ticket is the installer, and the day they're scheduled is the go-live day.
# CW_GOLIVE_TICKETS=installation, live
# CW_GOLIVE_STATUS=Scheduled
# Matching tickets that aren't go-lives, by words in the ticket summary (comma-separated).
# CW_GOLIVE_EXCLUDE=training

# --- Weekly email digest ---
# Every Monday David emails a digest: go-lives in the next 7 days, last week's tickets and after-hours
# calls, the oldest open tickets and thumbs-down notes. It's sent the first time David is running on
# or after Monday 7 AM Eastern (DIGEST_HOUR), once a week. Leave DIGEST_TO empty to turn it off.
# Preview it any time: python -m dbs_reporting.digest   (send now: add --send)
# DIGEST_TO=you@yourcompany.com
# Microsoft 365: SMTP_HOST=smtp.office365.com, port 587, your email and password (SMTP sign-in must
# be allowed for the mailbox). Gmail: smtp.gmail.com, port 587, and an app password.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=you@yourcompany.com
# SMTP_PASSWORD=
# DIGEST_FROM=          (defaults to SMTP_USER)
# DIGEST_HOUR=7

# --- Web app ---
# Logins are created with: python -m dbs_reporting.users add <username>
# Accounts and saved chats are stored in data/dbs_reporting.db. To store them elsewhere:
# DB_PATH=D:\DBS-Reporting-Data\dbs_reporting.db
