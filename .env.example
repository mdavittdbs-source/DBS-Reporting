# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- ConnectWise Manage (PSA) REST API ---
# Create an API Member in ConnectWise (System > Members > API Members) with a
# READ-ONLY security role, then generate API keys for it.
CW_SITE=api-na.myconnectwise.net        # api-eu / api-au / your on-prem host
CW_COMPANY_ID=yourcompanyid             # the company ID you type at CW login
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=                           # from https://developer.connectwise.com/ClientID
# CW_CODEBASE=v4_6_release              # only change if your instance differs

# --- Web app ---
# If set, the chat page requires HTTP Basic auth with this username/password.
APP_USERNAME=manager
APP_PASSWORD=change-me
