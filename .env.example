# --- AI model ---
# LLM_PROVIDER: "claude" (Anthropic API, pay per use) or "ollama" (free, runs on this PC).
LLM_PROVIDER=claude

# Claude: API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Ollama (only used when LLM_PROVIDER=ollama). Pick a model that supports tools,
# download it with `ollama pull <model>`, and put its name here.
OLLAMA_MODEL=qwen3:14b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=32768

# --- ConnectWise Manage (PSA) REST API ---
# Create an API Member in ConnectWise (System > Members > API Members) with a
# READ-ONLY security role, then generate API keys for it.
# CW_SITE: api-na.myconnectwise.net (US/Canada), api-eu... (Europe), api-au... (Australia),
# or your own server's hostname if self-hosted.
CW_SITE=api-na.myconnectwise.net
# CW_COMPANY_ID: the company ID you type on the ConnectWise login screen.
CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
# CW_CLIENT_ID: from https://developer.connectwise.com/ClientID
CW_CLIENT_ID=
# Only change the codebase if your instance differs:
# CW_CODEBASE=v4_6_release

# --- Web app ---
# If APP_PASSWORD is set, the chat page requires a login with this username/password.
APP_USERNAME=manager
APP_PASSWORD=
